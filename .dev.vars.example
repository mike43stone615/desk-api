# Copy this file to .dev.vars and fill in your local development values.
# .dev.vars is loaded by `wrangler dev` and is gitignored.

ENVIRONMENT=local
SESSION_DURATION_HOURS=720
RESET_TOKEN_DURATION_MINUTES=60
COMPLIANCE_OS_URL=http://localhost:3000
REGISTRY_API_URL=http://localhost:3456

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=AIza...
CENSUS_API_KEY=your-free-census-api-key
FOURSQUARE_API_KEY=your-free-foursquare-service-key
BEA_API_KEY=your-free-bea-api-key
REGISTRY_API_SECRET=your-registry-api-key
COMPLIANCE_OS_API_KEY=your-admin-key
RESEND_API_KEY=re-...

# Optional: comma-separated CORS origins for local dev
# Without this, CORS defaults to the production deskbusiness.co domains.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000



