{
  "checks": [
    {
      "name": "api-public-ready",
      "what": "the public API, through Cloudflare and the tunnel",
      "url": "https://api.deskbusiness.co/health/ready",
      "timeoutSec": 10,
      "expectStatus": 200,
      "expectJson": {
        "ok": true
      }
    },
    {
      "name": "api-public-degraded",
      "what": "a backend behind the API is down (the API itself still answers)",
      "url": "https://api.deskbusiness.co/health/ready",
      "timeoutSec": 10,
      "expectStatus": 200,
      "expectJson": {
        "degraded": false
      }
    },
    {
      "name": "web-app",
      "what": "the web app (Cloudflare Pages)",
      "url": "https://app.deskbusiness.co/",
      "timeoutSec": 10,
      "expectStatus": 200
    },
    {
      "name": "desk-api",
      "what": "desk-api on this machine",
      "url": "http://localhost:3458/health",
      "timeoutSec": 5,
      "expectStatus": 200
    },
    {
      "name": "registry-api",
      "what": "registry-api on this machine",
      "url": "http://localhost:3456/health",
      "timeoutSec": 5,
      "expectStatus": 200
    },
    {
      "name": "market-validation-api",
      "what": "market-validation-api on this machine",
      "url": "http://localhost:3457/health",
      "timeoutSec": 5,
      "expectStatus": 200
    },
    {
      "name": "compliance-os",
      "what": "compliance-os on this machine",
      "url": "http://localhost:3000/health",
      "timeoutSec": 5,
      "expectStatus": 200
    },
    {
      "name": "desk-oracle",
      "what": "desk-oracle on this machine",
      "url": "http://localhost:3459/health",
      "timeoutSec": 5,
      "expectStatus": 200
    },
    {
      "name": "canary-desk-api",
      "what": "a real API Library key works end to end through Cloudflare (Desk API grant)",
      "url": "https://api.deskbusiness.co/v1/auth/session",
      "headers": {
        "x-api-key": "file:C:/Users/User/.desk/canary-key.txt"
      },
      "timeoutSec": 20,
      "expectStatus": 200,
      "expectKeys": [
        "user"
      ],
      "everyMinutes": 5
    },
    {
      "name": "canary-registry",
      "what": "the same key reaches the Registry API through the gateway",
      "url": "https://api.deskbusiness.co/v1/gateway/registry/name-availability",
      "method": "POST",
      "body": {
        "businessName": "Canary Probe Widgets LLC",
        "stateOfFormation": "FL"
      },
      "headers": {
        "x-api-key": "file:C:/Users/User/.desk/canary-key.txt"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status"
      ],
      "everyMinutes": 5
    },
    {
      "name": "canary-market",
      "what": "the same key reaches the Market Validation API through the gateway",
      "url": "https://api.deskbusiness.co/v1/gateway/market/scoring-methodology",
      "headers": {
        "x-api-key": "file:C:/Users/User/.desk/canary-key.txt"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "everyMinutes": 5
    },
    {
      "name": "name-check-co",
      "what": "a real business-name lookup for Colorado (checks the state's data source is answering and understood)",
      "url": "http://localhost:3456/functions/v1/check-business-name-availability",
      "method": "POST",
      "body": {
        "businessName": "Uptime Probe Widgets LLC",
        "stateOfFormation": "CO"
      },
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status",
        "available"
      ],
      "everyMinutes": 360
    },
    {
      "name": "name-check-dc",
      "what": "a real business-name lookup for the District of Columbia (checks the state's data source is answering and understood)",
      "url": "http://localhost:3456/functions/v1/check-business-name-availability",
      "method": "POST",
      "body": {
        "businessName": "Uptime Probe Widgets LLC",
        "stateOfFormation": "DC"
      },
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status",
        "available"
      ],
      "everyMinutes": 360
    },
    {
      "name": "name-check-hi",
      "what": "a real business-name lookup for Hawaii (checks the state's data source is answering and understood)",
      "url": "http://localhost:3456/functions/v1/check-business-name-availability",
      "method": "POST",
      "body": {
        "businessName": "Uptime Probe Widgets LLC",
        "stateOfFormation": "HI"
      },
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status",
        "available"
      ],
      "everyMinutes": 360
    },
    {
      "name": "name-check-ny",
      "what": "a real business-name lookup for New York (checks the state's data source is answering and understood)",
      "url": "http://localhost:3456/functions/v1/check-business-name-availability",
      "method": "POST",
      "body": {
        "businessName": "Uptime Probe Widgets LLC",
        "stateOfFormation": "NY"
      },
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status",
        "available"
      ],
      "everyMinutes": 360
    },
    {
      "name": "name-check-or",
      "what": "a real business-name lookup for Oregon (checks the state's data source is answering and understood)",
      "url": "http://localhost:3456/functions/v1/check-business-name-availability",
      "method": "POST",
      "body": {
        "businessName": "Uptime Probe Widgets LLC",
        "stateOfFormation": "OR"
      },
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 30,
      "expectStatus": 200,
      "expectKeys": [
        "status",
        "available"
      ],
      "everyMinutes": 360
    },
    {
      "name": "registry-data-fresh",
      "what": "the Florida and Virginia business-record imports (weekly sync; a whole month without new data means the sync or its source has stopped)",
      "kind": "freshness",
      "url": "http://localhost:3456/functions/v1/registry-sync-status",
      "headers": {
        "x-api-key": "env:REGISTRY_API_SECRET"
      },
      "timeoutSec": 15,
      "path": "states",
      "field": "lastSyncedAt",
      "only": [
        "FL",
        "VA"
      ],
      "maxAgeHours": 1080,
      "everyMinutes": 720
    },
    {
      "name": "provider-keys-and-quotas",
      "what": "OpenAI, Google Places or Resend refused our key or reported the quota used up",
      "kind": "counter",
      "url": "http://localhost:3458/metrics",
      "headers": {
        "x-api-key": "env:METRICS_DOCS_API_KEY"
      },
      "timeoutSec": 10,
      "metric": "desk_provider_calls_total",
      "labels": {
        "outcome": "auth_error|quota"
      },
      "maxIncrease": 0,
      "unit": "refused calls",
      "failuresBeforeAlert": 1
    }
  ],
  "processes": [
    {
      "name": "cloudflare-tunnel",
      "what": "the Cloudflare tunnel that carries all public traffic to this machine (a watchdog restarts it every 5 minutes if it dies)",
      "processName": "cloudflared.exe",
      "commandLineLike": "tunnel"
    }
  ],
  "disk": {
    "drive": "C",
    "minFreePercent": 10,
    "what": "free space on the drive holding the databases and backups"
  },
  "backups": {
    "dir": "C:\\Users\\User\\desk-api\\backups",
    "maxAgeHours": 36,
    "what": "the newest desk-api database backup"
  },
  "failuresBeforeAlert": 2,
  "recovery": {
    "checks": [
      "desk-api"
    ],
    "afterFailures": 3,
    "cooldownMinutes": 30,
    "repo": "mike43stone615/desk-api",
    "workflow": "deploy.yml"
  }
}
