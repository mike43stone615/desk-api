# This file documents all environment variables used by desk-api.
# For Cloudflare Workers, non-sensitive vars go in wrangler.toml [vars].
# Secrets are set via: wrangler secret put <NAME>
# For local development, copy this to .dev.vars and fill in values.

# ── Cloudflare Bindings (managed via wrangler.toml) ──────────────────────────
# DB=<D1 database binding — set in wrangler.toml>
# STORAGE=<R2 bucket binding — set in wrangler.toml>

# ── Non-sensitive configuration (set in wrangler.toml [vars]) ─────────────────
ENVIRONMENT=development
SESSION_DURATION_HOURS=720
RESET_TOKEN_DURATION_MINUTES=60
COMPLIANCE_OS_URL=http://localhost:3000
REGISTRY_API_URL=http://localhost:3456

# ── Secrets (set via `wrangler secret put` in production) ────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=AIza...
REGISTRY_API_SECRET=your-sync-secret-here
COMPLIANCE_OS_API_KEY=your-compliance-api-key

# ── Optional: email sending (not implemented — add your transport here) ────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
