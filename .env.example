DATABASE_URL="postgresql://desk_api_dev:desk_api_dev@127.0.0.1:5433/desk_api_dev"
PORT=3458

# Optional — Redis for shared rate-limit state (falls back to in-process memory if unset)
REDIS_URL="redis://127.0.0.1:6390"

# Optional — comma-separated allowed CORS origins (default: https://app.deskbusiness.co)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Optional — number of trusted reverse-proxy hops in front of this service.
# Default 0 means X-Forwarded-For is ignored entirely and request.ip is used directly.
TRUSTED_PROXY_COUNT=0

# Optional — pino log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Optional — OpenTelemetry distributed tracing (no-op if unset)
# OTEL_SERVICE_NAME=desk-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

ENVIRONMENT=development
# Session token lifetime in hours (default 720 = 30 days)
SESSION_DURATION_HOURS=720
# Password-reset link lifetime in minutes (default 60)
RESET_TOKEN_DURATION_MINUTES=60
# Email-confirmation link lifetime in minutes (default 1440 = 24 hours)
CONFIRMATION_TOKEN_DURATION_MINUTES=1440
# Minimum seconds between resending a reset/confirmation link (default 60)
RESEND_COOLDOWN_SECONDS=60

# Comma-separated list of emails granted admin (table-browser) access.
ADMIN_EMAILS=you@example.com

# Optional: a request with this exact value as its x-api-key header is
# treated as admin without a session, same pattern as the sibling services'
# admin routes. Leave unset to require session + ADMIN_EMAILS only.
ADMIN_API_KEY=

# Sibling-service integration URLs/keys
COMPLIANCE_OS_URL=http://localhost:3000
COMPLIANCE_OS_API_KEY=
REGISTRY_API_URL=http://localhost:3456
REGISTRY_API_SECRET=
REGISTRY_API_ADMIN_KEY=
MARKET_API_URL=http://localhost:3457
MARKET_API_KEY=
# API Library (developer keys) — optional. Without these, keys can still be
# granted desk_api access; registry_api / market_validation_api grants are
# reported unavailable until both are set.
#   MARKET_API_ADMIN_KEY = market-validation-api's ADMIN_API_KEY
#   GATEWAY_KEY_ENCRYPTION_SECRET = 64 hex chars, generate with: openssl rand -hex 32
MARKET_API_ADMIN_KEY=
GATEWAY_KEY_ENCRYPTION_SECRET=

# Optional — business-setup classification (falls back to heuristics without a key)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Optional — city/place autocomplete for the setup wizard
GOOGLE_PLACES_API_KEY=AIza...

# Outbound auth email (password-reset/email-confirmation links). While unset,
# these no-op with a warning log instead of sending — signup/reset/confirm
# still work; pull the token straight out of the DB for local testing.
RESEND_API_KEY=
EMAIL_FROM=noreply@deskbusiness.co
# Base URL used to build the emailed links ({appBaseUrl}/reset-password?token=...)
APP_BASE_URL=https://deskbusiness.co

# Optional — when set, GET /metrics and GET /docs (+ /docs/openapi.json)
# require a matching `x-api-key` header. Left unset, both stay fully public
# with no auth (today's default behavior, unchanged). Recommended for
# production — set this, or restrict network access to these paths at the
# firewall/reverse-proxy level (they're diagnostic endpoints, not needed by
# the Flutter client).
METRICS_DOCS_API_KEY=

# Optional — where a security researcher should report a problem: an email address or an https:// page. When set it is
# published at /.well-known/security.txt (RFC 9116); left unset, that path answers 404.
SECURITY_CONTACT=

# After startup:
#   Swagger UI    → http://localhost:3458/docs
#   OpenAPI JSON  → http://localhost:3458/docs/openapi.json
#   Metrics       → http://localhost:3458/metrics
#   Health        → http://localhost:3458/health
